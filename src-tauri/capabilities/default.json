{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "OmniKit 默认窗口能力：文件保存对话框与文件写入",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }]
    }
  ]
}
